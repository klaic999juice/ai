# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Database Configuration
DATABASE_URL=sqlite:///./ai_chat.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/ai_db

# Application Settings
APP_NAME=AI Q&A Website
APP_DESCRIPTION=An intelligent question-answering website powered by OpenAI
DEBUG=false

# API Settings
MAX_TOKENS=2000
TEMPERATURE=0.7
TOP_P=1.0

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
